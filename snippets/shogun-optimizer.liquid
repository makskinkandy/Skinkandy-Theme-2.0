    }

    const dispatcherConfig = {
      shop: {
        shopId: "6de41eab-be1a-408c-8243-fce0d3a4f2e6",
        shopDomain: "skinkandy-au.myshopify.com",
        analyticsUrl: "https://shogun-abc-production.global.ssl.fastly.net",
        geoLocationApi: "https://ipinfo.io/json?token=f2ae3a557d807b",
        storefrontAccessToken: "4fa9146832d24c1bd14ddbecf3a137fd",
        defaultThemeId: shopMetafieldConfig.default_theme_id ? shopMetafieldConfig.default_theme_id.toString() : null,
        configExpiresAt: shopMetafieldConfig.expires_at,
      },
      page: {
        pageId: "{{ content.id }}",
        pageType: "{% assign shg_page_types = 'search,cart,password,gift_card' | split: ',' %}{% if template.directory == 'customers' %}customers{% elsif template.name == 'list-collections' %}list-collections{% elsif article %}article{% elsif blog %}blog{% elsif page %}page{% elsif product %}product{% elsif collection %}collection{% elsif metaobject %}metaobject{% elsif template.name == 'index' %}homepage{% elsif template.name == '404' %}not_found{% elsif shg_page_types contains template.name %}{{ template.name }}{% else %}other{% endif %}",
        templateName: "{{ template.name }}",
        templateSuffix: "{{ template.suffix }}",
        templateDirectory: "{{ template.directory }}",
        themeId: "141120176266",
        languageRootUrl: "{{ localization.language.root_url }}",
        path: window.location.pathname,
        currentCartVariantId: {% if cart.attributes.shogun_variant_id %}"{{ cart.attributes.shogun_variant_id }}"{% else %}null{% endif %},
      },
      session: {
        sessionId: urlParams.get('shgSessionId'),
        customerId: "{{ customer.id }}",
        isB2B: {{ customer.b2b? | default: false }},
      },
      assignmentStrategy: shopMetafieldConfig.method,
      botDetectionLevel: shopMetafieldConfig.bot_detection,
      publishedOptimizations: optimizationsData,
      configExpired: configExpired,
