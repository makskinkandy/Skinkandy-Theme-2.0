    // an Error cannot be sent as-is: message and stack are non-enumerable, so JSON.stringify gives {}
    const describeThrown = (value) =>
      value instanceof Error ? { message: value.message, stack: value.stack } : String(value);

    const reportExclusion = (reason, details) => {
      try {
        if (typeof fetch !== 'function') return;

        fetch("https://shogun-abc-production.global.ssl.fastly.net/dispatcher/excluded", {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: 'excluded',
            shop_id: "6de41eab-be1a-408c-8243-fce0d3a4f2e6",
            reason: reason,
            details: details || {}
          }),
          keepalive: true,
        }).catch(() => {});
      } catch (_error) {
        // reporting a bail must never be a thing that breaks a merchant's page
      }
    };

    // If the referrer url is the Shopify admin url or other known merchant domains, then set a local storage shg_is_merchant flag to true
    // This is used to remove the preview bar from the page for shoppers
    //
    // Reading localStorage throws outright where the origin is denied storage, and this only decides whether a
    // merchant sees the preview bar. Letting it escape would take the dispatcher down with it and leave the visitor
    // reporting nothing at all.
    try {
      const referrer = document.referrer
      const merchantDomains = ['admin.shopify.com', 'ab.shgapi.com', 'abc.shogun.dev']
      if (!localStorage.getItem('_shg_is_merchant') && merchantDomains.some(domain => referrer.includes(domain))) {
        console.debug('shogun: Setting shg_is_merchant to true')
